{
  "name": "jwt-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small JWT generator with a vanilla JavaScript frontend and TypeScript Node.js server.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "jose": "^6.1.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
